{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "figure_model",
  "description": "Source-bound, editable scientific figure model. Interface v1.0/v1.1; mechanism/pathway additions per work/CONTRACT.md section 3 (see also schemas/mech_ontology.json, the machine-readable twin of this schema's enums).",
  "type": "object",
  "required": ["schema_version", "case_id", "figure", "entities", "relations", "containers", "legend", "provenance"],
  "additionalProperties": true,
  "definitions": {
    "source": {
      "type": "object",
      "description": "Provenance binding. quote must occur verbatim (whitespace-normalised) in the referenced source unit. Locators: L12 | L12-L18 | p3 | table:col | fig:1 | json:entities/<id>.",
      "required": ["path", "locator", "kind"],
      "properties": {
        "path": {"type": "string", "description": "POSIX path relative to the input root"},
        "locator": {"type": "string", "description": "L12 | L12-L18 | p3 | table:col | fig:1 | json:entities/<id>"},
        "quote": {"type": "string"},
        "kind": {"enum": ["explicit", "derived", "unsupported"]},
        "derived_from": {"type": "array", "items": {"type": "string"}}
      }
    },
    "layout_hint": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "level": {"type": "integer"},
        "order": {"type": "integer"},
        "group": {"type": "string"}
      }
    },
    "membrane_role": {
      "enum": ["transmembrane", "membrane_anchored", "luminal", "cytosolic", "extracellular", "na"],
      "description": "CONTRACT 3.3. transmembrane/membrane_anchored must live in a kind='membrane' container (E_MEMBRANE_PLACEMENT)."
    },
    "evidence": {
      "type": "object",
      "description": "CONTRACT 3.6. strength maps to the frozen line width high=1.4pt | medium=1.0pt | low=0.6pt.",
      "required": ["strength", "kind"],
      "properties": {
        "strength": {"enum": ["high", "medium", "low"]},
        "kind": {"enum": ["direct", "indirect", "inferred"]},
        "note": {"type": "string"},
        "source": {"$ref": "#/definitions/source"}
      }
    },
    "abundance": {
      "type": "object",
      "description": "CONTRACT 3.6 node-size encoding. A value without a unit is E_UNIT_MISSING.",
      "required": ["value", "unit"],
      "properties": {
        "value": {"type": "number"},
        "unit": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/definitions/source"}
      }
    },
    "encoding": {
      "type": "object",
      "description": "CONTRACT 3.6 legend encoding, generated by the model, never hand-written. mapping values == the visual values used on the figure == the values present in the data (E_LEGEND_DATA_MISMATCH).",
      "required": ["channel", "field", "mapping"],
      "properties": {
        "channel": {"enum": ["color", "line_width", "node_size", "line_style"]},
        "field": {"type": "string"},
        "unit": {"type": ["string", "null"]},
        "mapping": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["value", "visual"],
            "properties": {
              "value": {"type": ["string", "number", "null"]},
              "visual": {"type": ["string", "number", "null"]}
            }
          }
        }
      }
    },
    "unit_status": {
      "description": "Per-column unit disposition: 'declared' | 'declared_in_header' | 'dimensionless' | 'unknown'. A null unit with status 'dimensionless' is declared unitless, not missing.",
      "enum": ["declared", "declared_in_header", "dimensionless", "unknown"]
    }
  },
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1"]},
    "case_id": {"type": "string"},
    "figure": {
      "type": "object",
      "required": ["id", "kind", "canvas"],
      "properties": {
        "id": {"type": "string"},
        "kind": {
          "enum": ["relationship_schematic", "chart", "flowchart", "mixed", "mechanism_pathway"],
          "description": "mechanism_pathway is the primary mechanism/pathway figure type (CONTRACT 3.1)."
        },
        "title": {"type": "object", "properties": {"text": {"type": "string"}, "source": {"$ref": "#/definitions/source"}}},
        "canvas": {
          "type": "object",
          "required": ["width_mm", "height_mm"],
          "properties": {
            "width_mm": {"type": "number", "exclusiveMinimum": 0},
            "height_mm": {"type": "number", "exclusiveMinimum": 0},
            "background": {"type": "string"}
          }
        },
        "flow": {
          "type": "object",
          "description": "CONTRACT 3.5. ranks is {entityId: int}; a non-feedback edge must raise the rank, and a directed cycle of non-feedback edges is E_FLOW_DIRECTION.",
          "properties": {
            "orientation": {"enum": ["top_down", "left_right"]},
            "ranks": {"type": "object", "additionalProperties": {"type": "integer"}}
          }
        },
        "style": {
          "type": "object",
          "properties": {
            "font_stack": {"type": "array", "items": {"type": "string"}, "minItems": 1},
            "color_space": {"enum": ["RGB", "CMYK"]},
            "font_sizes_pt": {"type": "object", "additionalProperties": {"type": "number"}},
            "line_widths_pt": {"type": "object", "additionalProperties": {"type": "number"}},
            "palette": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "kind", "source"],
        "properties": {
          "id": {"type": "string"},
          "label": {"type": "string", "minLength": 1},
          "kind": {
            "enum": ["gene", "protein", "process", "treatment", "sample", "category", "axis", "concept", "compound", "cell", "condition", "complex", "organelle", "cell_type", "metabolite", "modification_site", "stimulus", "drug"],
            "description": "CONTRACT 3.2. gene and protein must not be interchanged (E_GENE_PROTEIN_CONFUSION)."
          },
          "container": {"type": ["string", "null"]},
          "membrane_role": {"$ref": "#/definitions/membrane_role"},
          "attributes": {
            "type": "object",
            "description": "normalized_symbol, synonyms[], modification_site, domains[] ...",
            "properties": {
              "normalized_symbol": {"type": "string"},
              "synonyms": {"type": "array", "items": {"type": "string"}},
              "modification_site": {"type": "string"}
            }
          },
          "value": {"type": ["number", "string", "null"]},
          "unit": {"type": ["string", "null"]},
          "unit_status": {"$ref": "#/definitions/unit_status"},
          "abundance": {"$ref": "#/definitions/abundance"},
          "layout": {"$ref": "#/definitions/layout_hint"},
          "source": {"$ref": "#/definitions/source"}
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "from", "to", "type", "direction", "source"],
        "properties": {
          "id": {"type": "string"},
          "from": {"type": "string"},
          "to": {"type": "string"},
          "type": {
            "enum": ["activation", "inhibition", "containment", "sequence", "causation", "association", "membership", "binding", "modification", "transport", "transcription", "translation", "feedback"],
            "description": "CONTRACT 3.4 frozen style table: activation normal/solid, inhibition tee/solid, binding none/solid, modification normal/dashed, transport normal/solid, transcription normal/solid, translation normal/solid, feedback normal/dashed, association none/dotted, containment|membership none/dotted, sequence|causation normal/solid (E_INTERACTION_STYLE_MISMATCH)."
          },
          "direction": {"enum": ["forward", "bidirectional", "none"]},
          "label": {"type": "string"},
          "crosses": {
            "type": "array",
            "items": {"type": "string"},
            "description": "transport must declare crosses:[fromContainer,toContainer]"
          },
          "evidence": {"$ref": "#/definitions/evidence"},
          "style": {
            "type": "object",
            "properties": {
              "stroke": {"enum": ["solid", "dashed", "dotted"]},
              "arrow": {"enum": ["normal", "tee", "none"]},
              "color": {"type": "string"},
              "width_pt": {"type": "number"}
            }
          },
          "source": {"$ref": "#/definitions/source"}
        }
      }
    },
    "containers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "members", "source"],
        "properties": {
          "id": {"type": "string"},
          "label": {"type": "string"},
          "kind": {
            "enum": ["compartment", "membrane", "cell", "group"],
            "description": "CONTRACT 3.3. compartment names: nucleus | cytosol | mitochondrion | er | golgi | lysosome | extracellular | cytoplasm."
          },
          "compartment": {
            "enum": ["nucleus", "cytosol", "mitochondrion", "er", "golgi", "lysosome", "extracellular", "cytoplasm"]
          },
          "members": {"type": "array", "items": {"type": "string"}},
          "layout": {"$ref": "#/definitions/layout_hint"},
          "source": {"$ref": "#/definitions/source"}
        }
      }
    },
    "legend": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "kind", "source"],
        "properties": {
          "id": {"type": "string"},
          "label": {"type": "string"},
          "kind": {"enum": ["category", "marker", "line_style", "value_scale"]},
          "value": {"type": ["string", "number", "null"]},
          "color": {"type": ["string", "null"]},
          "marker": {"type": ["string", "null"]},
          "encoding": {"$ref": "#/definitions/encoding"},
          "source": {"$ref": "#/definitions/source"}
        }
      }
    },
    "legend_encoding": {
      "type": "array",
      "description": "Encodings declared by a material workorder; the model must verify them against the data before adopting them.",
      "items": {"$ref": "#/definitions/encoding"}
    },
    "data": {
      "type": ["object", "null"],
      "properties": {
        "path": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"]},
        "columns": {"type": "array", "items": {"type": "string"}},
        "units": {
          "type": "object",
          "description": "column -> unit string; an explicit null means 'dimensionless by convention' (p_value, fold_change, count ...).",
          "additionalProperties": {"type": ["string", "null"]}
        },
        "unit_status": {"type": "object", "additionalProperties": {"$ref": "#/definitions/unit_status"}},
        "rows": {"type": "array", "items": {"type": "array"}},
        "series": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {"type": "string"},
              "x": {"type": "array"},
              "y": {"type": "array"},
              "unit": {"type": ["string", "null"]},
              "color": {"type": "string"},
              "width_pt": {"type": "number"},
              "evidence_tier": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "group_field": {"type": "string"},
        "x": {"type": "string"},
        "y": {"type": "string"},
        "chart": {"type": "object"}
      }
    },
    "panels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {"type": "string"},
          "caption": {"type": "object"},
          "layout": {"$ref": "#/definitions/layout_hint"}
        }
      }
    },
    "uncertainty": {"type": "array", "items": {"type": "object"}},
    "provenance": {
      "type": "object",
      "required": ["generated_by", "source_files"],
      "properties": {
        "generated_by": {"type": "string"},
        "created_utc": {"type": "string"},
        "model_version": {"type": "string"},
        "source_files": {"type": "array", "items": {"type": "object", "required": ["path", "sha256"]}}
      }
    }
  }
}
