    "E_FLOW_DIRECTION": "CONTRACT 3.5: non-feedback edge that does not raise the rank, a directed cycle of non-feedback edges, a missing/incomplete figure.flow.ranks, or a non-backward feedback arc",
    "E_INTERACTION_STYLE_MISMATCH": "CONTRACT 3.4: rendered (arrow, stroke) differs from the frozen table, or a drawn type has no legend entry",
    "E_COMPARTMENT_MISMATCH": "CONTRACT 3.4: binding whose partners sit in different compartments",
    "E_TYPE_CONSTRAINT_VIOLATION": "CONTRACT 3.4: transcription/translation endpoint kinds or a transport that crosses no boundary",
    "E_MODIFICATION_UNNAMED": "CONTRACT 3.4: modification edge whose label does not name the modification kind",
    "E_LEGEND_DATA_MISMATCH": "CONTRACT 3.6: legend[].encoding mapping values, visuals and data values do not correspond one-to-one"
